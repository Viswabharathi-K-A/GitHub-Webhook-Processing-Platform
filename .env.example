# Local development only. Copy to .env and choose your own password.
POSTGRES_DB=webhook_platform
POSTGRES_USER=webhook_app
POSTGRES_PASSWORD=replace_with_a_local_password

# Compose sets the API's database host to db and port to 5432.

# Outbox publisher configuration (not yet wired into Compose).
AWS_DEFAULT_REGION=us-west-2
# Set this to the URL returned when creating the delivery queue.
SQS_QUEUE_URL=
# Optional: set only when using a local SQS emulator; leave blank for AWS.
# In a container, use the emulator's Compose service name rather than localhost.
SQS_ENDPOINT_URL=
